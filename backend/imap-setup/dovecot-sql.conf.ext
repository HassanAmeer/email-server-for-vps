# ==============================================================================
# Dovecot PostgreSQL Authentication Configuration
# ==============================================================================

# PostgreSQL Driver
driver = pgsql

# PostgreSQL Connection String (Update host, dbname, user, and password)
connect = host=127.0.0.1 dbname=email_server user=postgres password=YOUR_PG_PASSWORD

# Default Password Scheme (PLAIN, BCRYPT, SHA512-CRYPT)
default_pass_scheme = PLAIN

# Password Query: Authenticate mailbox user against mailbox_users table
password_query = \
  SELECT email AS user, \
         COALESCE(plain_password, password_hash) AS password \
  FROM mailbox_users \
  WHERE LOWER(email) = LOWER('%u')

# User Query: Return user Maildir home directory
user_query = \
  SELECT 5000 AS uid, \
         5000 AS gid, \
         '/var/www/email-server-for-vps/backend/storage/maildir/%d/%n' AS home, \
         'maildir:/var/www/email-server-for-vps/backend/storage/maildir/%d/%n:LAYOUT=fs:DIRNAME=.' AS mail \
  FROM mailbox_users \
  WHERE LOWER(email) = LOWER('%u')

# Iterate query (for doveadm user listing)
iterate_query = SELECT email AS user FROM mailbox_users
